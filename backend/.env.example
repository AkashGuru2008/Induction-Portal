# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/induction_portal
# Alternatively, discrete params (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=induction_portal
PGUSER=postgres
PGPASSWORD=postgres

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin (used by `npm run seed:admin`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Email (SMTP). If left blank, emails are logged to console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Induction Portal <no-reply@example.com>"
